<!DOCTYPE html>

<html lang="tr" data-tema="aydinlik">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <meta name="theme-color" content="#eef0f8" />
        <script src="/tema.js"></script>
        <title>404 - Sayfa Bulunamadı · D-Tube Video İndirici</title>
        <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet" />
        <link rel="stylesheet" href="/tema.css" />
    </head>
    <body class="sayfa-404">
        <div class="tema-sabit">
            <button class="tema-btn" id="temaDugmesi" type="button" data-tema-btn aria-label="Karanlık moda geç"></button>
        </div>
        <div class="kap kap-kart">
            <div class="sayi">404</div>
            <h1>Sayfa Bulunamadı</h1>
            <p>Aradığınız sayfa mevcut değil veya taşınmış olabilir.</p>
            <a href="/" class="geri-btn">Ana Sayfaya Dön</a>
            <div class="sayac"><span id="s">10</span> saniye sonra ana sayfaya yönlendirileceksiniz.</div>
        </div>
        <script>
            let n = 10;
            const el = document.getElementById("s");
            setInterval(() => {
                n--;
                el.textContent = n;
                if (n <= 0) location.href = "/";
            }, 1000);
        </script>
    </body>
</html>
