<!DOCTYPE html>

<html lang="tr" data-tema="aydinlik">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Video İndirici</title>
        <link rel="icon" type="image/png" href="/favicon.png">
        <meta name="theme-color" content="#eef0f8">
        <script src="/tema.js"></script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/tema.css">
    </head>
    <body class="sayfa-ana">
        <header>
            <div class="header-ic">
                <a href="/" class="logo">
                    <img class="logo-simge" src="/favicon.png" alt="">
                    <span class="logo-yazi"><span>Video İndirici</span></span>
                </a>
                <button class="tema-btn" id="temaDugmesi" type="button" data-tema-btn aria-label="Karanlık moda geç"></button>
            </div>
        </header>
        <main>
            <section class="kahraman">
                <div class="kahraman-rozet">✦ Ücretsiz · Kayıtsız · Hızlı ✦</div>
                <h1>Videolarınızı <span>Ücretsiz İndirin</span></h1>
                <p>YouTube, Instagram, TikTok ve Twitter'dan videoları veya sesleri hızlı, kolay ve güvenilir biçimde indirin.</p>
            </section>
            <div class="indirme-kutusu">
                <div class="mod-sekmeleri" role="tablist" aria-label="İndirme yöntemi">
                    <button class="mod-sekmesi aktif" id="baglantiSekmesi" type="button" role="tab" aria-selected="true">Bağlantı ile indir</button>
                    <button class="mod-sekmesi" id="aramaSekmesi" type="button" role="tab" aria-selected="false">YouTube'da ara</button>
                </div>
                <div id="baglantiPanel">
                    <div class="url-giris-satiri">
                        <input type="url" class="url-giris" id="urlGiris" placeholder="Bağlantıyı buraya yapıştırın..." autocomplete="off" spellcheck="false">
                        <button class="analiz-btn" id="analizBtn" type="button">Analiz Et</button>
                    </div>
                </div>
                <div class="arama-panel" id="aramaPanel">
                    <div class="arama-giris-satiri">
                        <input type="search" class="url-giris" id="aramaGiris" placeholder="YouTube'da ne aramak istersiniz?" autocomplete="off" spellcheck="false" maxlength="120">
                        <button class="analiz-btn" id="aramaBtn" type="button">Ara</button>
                    </div>
                    <div class="arama-sonuclari" id="aramaSonuclari" aria-live="polite"></div>
                </div>
                <div class="platform-satirlar">
                    <span class="platform-etiket">▶ YouTube</span>
                    <span class="platform-etiket">📷 Instagram</span>
                    <span class="platform-etiket">🐦 Twitter/X</span>
                    <span class="platform-etiket">♪ TikTok</span>
                    <span class="platform-etiket">⚡ Shorts</span>
                </div>
                <div class="sonuc-alani" id="sonucAlani">
                    <button class="arama-geri" id="aramaGeri" type="button" hidden>← Arama sonuçlarına dön</button>
                    <div class="medya-bilgi" id="medyaBilgi"></div>
                    <button class="duzenle-btn" id="duzenleBtn" type="button"><span id="duzenleBtnIcerik">✂ Videoyu düzenle</span></button>
                    <div class="duzenleme-panel" id="duzenlemePanel">
                        <div class="duzenleme-baslik">Kırpılacak aralığı seçin</div>
                        <video class="duzenleme-video" id="duzenlemeVideo" controls preload="metadata"></video>
                        <video class="kare-video" id="kareVideo" preload="auto" muted playsinline aria-hidden="true"></video>
                        <div class="zaman-satiri"><span id="baslangicEtiketi">00:00</span><span id="seciliSureEtiketi">Seçim: 00:00</span><span id="bitisEtiketi">00:00</span></div>
                        <div class="timeline">
                            <div class="timeline-secili" id="timelineSecili"></div>
                            <input id="baslangicKaydiraci" type="range" min="0" max="1" step="0.1" value="0" aria-label="Başlangıç zamanı">
                            <input id="bitisKaydiraci" type="range" min="0" max="1" step="0.1" value="1" aria-label="Bitiş zamanı">
                        </div>
                        <div class="zaman-alanlari">
                            <label class="zaman-alani">Başlangıç <input id="baslangicZamani" type="text" value="00:00" inputmode="numeric"></label>
                            <label class="zaman-alani">Bitiş <input id="bitisZamani" type="text" value="00:00" inputmode="numeric"></label>
                        </div>
                        <div class="kareler" aria-live="polite">
                            <div class="kare">
                                <div class="kare-baslik"><span>Başlangıç karesi</span><span id="baslangicKareZamani">00:00</span></div>
                                <img id="baslangicKaresi" alt="Seçilen başlangıç karesi">
                            </div>
                            <div class="kare">
                                <div class="kare-baslik"><span>Bitiş karesi</span><span id="bitisKareZamani">00:00</span></div>
                                <img id="bitisKaresi" alt="Seçilen bitiş karesi">
                            </div>
                        </div>
                        <p class="duzenleme-not">Önizleme düşük çözünürlükte hazırlanır. Kayıt sırasında seçtiğiniz kaliteyle MP4 oluşturulur.</p>
                    </div>
                    <div class="oynatma-panel" id="oynatmaPanel" hidden>
                        <div class="oynatma-ust">
                            <div class="oynatma-baslik">Oynatma listesindeki videolar</div>
                            <div class="oynatma-sayac" id="oynatmaSayac"></div>
                        </div>
                        <div class="oynatma-kontrol">
                            <span class="not-kucuk">İndirmek istediklerinizi seçin · En fazla 20 video seçilebilir</span>
                            <button class="oynatma-tumunu-sec" id="oynatmaTumunuSec" type="button">Tümünü kaldır</button>
                        </div>
                        <div class="oynatma-listesi" id="oynatmaListesi"></div>
                    </div>
                    <div class="format-baslik" id="videoFormatBaslik">Video Formatları</div>
                    <div class="format-grid" id="videoFormatlar"></div>
                    <div class="format-baslik" id="sesFormatBaslik">Ses Formatları</div>
                    <div class="format-grid" id="sesFormatlar"></div>
                    <button class="indir-btn" id="indirBtn" type="button" disabled><span>↓</span> Format Seçin</button>
                    <div class="indirme-ilerleme" id="indirmeIlerleme" role="status" aria-live="polite" hidden>
                        <div class="indirme-ilerleme-satir">
                            <span id="indirmeIlerlemeMetni">İndirme hazırlanıyor...</span>
                            <span class="indirme-ilerleme-yuzde" id="indirmeIlerlemeYuzde">Bekliyor</span>
                        </div>
                        <div class="indirme-ilerleme-cubuk" role="progressbar" aria-label="İndirme ilerlemesi" aria-valuemin="0" aria-valuemax="100" aria-valuetext="İndirme sürüyor">
                            <div class="indirme-ilerleme-dolgu"></div>
                        </div>
                    </div>
                    <div id="indirLink"></div>
                </div>
                <div class="mesaj-kutusu" id="mesajKutusu"></div>
            </div>
            <section class="ozellikler" aria-labelledby="ozellikBaslik">
                <div class="bolum-baslik">
                    <span class="bolum-etiket">Video İndirici ile daha fazlası</span>
                    <h2 id="ozellikBaslik">İndirme akışını kendi ihtiyacınıza göre şekillendirin</h2>
                    <p>İçeriği bulun, listenizi seçin veya videonun yalnızca ihtiyacınız olan bölümünü hazırlayın. Her adım tek bir sade akışta.</p>
                </div>
                <div class="ozellik-vitrin">
                    <article class="ozellik-spot ozellik-spot-main">
                        <div class="ozellik-spot-badge"><span aria-hidden="true">✂</span> Video düzenleme</div>
                        <h3>Sadece ihtiyacınız olan kısmı indirin</h3>
                        <p>Timeline üzerinden başlangıç ve bitiş aralığını seçin, karelerle kontrol edin ve istediğiniz kaliteyle MP4 olarak kaydedin.</p>
                        <div class="ozellik-timeline" aria-hidden="true">
                            <div class="ozellik-timeline-ust"><span>00:42</span><span>03:18</span></div>
                            <div class="ozellik-timeline-cizgi"><i class="ozellik-timeline-kulp bas"></i><i class="ozellik-timeline-kulp son"></i></div>
                            <div class="ozellik-timeline-alt"><span>Başlangıç karesi</span><span>Bitiş karesi</span></div>
                        </div>
                    </article>
                    <div class="ozellik-yanlar">
                        <article class="ozellik-spot ozellik-yan ozellik-spot-liste">
                            <div class="ozellik-spot-badge"><span aria-hidden="true">☷</span> Oynatma listeleri</div>
                            <h3>Kontrol sizde olsun</h3>
                            <p>Listenin tamamını veya yalnızca seçtiğiniz videoları toplu olarak indirin.</p>
                            <div class="ozellik-liste-onizleme" aria-hidden="true">
                                <div class="ozellik-liste-satir">Favori video · 1080p</div>
                                <div class="ozellik-liste-satir">Yeni bölüm · MP3</div>
                            </div>
                        </article>
                        <article class="ozellik-spot ozellik-yan ozellik-spot-arama">
                            <div class="ozellik-spot-badge"><span aria-hidden="true">⌕</span> YouTube araması</div>
                            <h3>Aradığınızı daha hızlı bulun</h3>
                            <p>Sonuçları küçük resim ve bilgilerle karşılaştırın, doğru videoyu seçip indirmeye geçin.</p>
                            <div class="ozellik-arama-onizleme" aria-hidden="true">
                                <div class="ozellik-arama-kare"></div>
                                <div class="ozellik-arama-kare"></div>
                                <div class="ozellik-arama-kare"></div>
                            </div>
                        </article>
                    </div>
                </div>
                <div class="ozellik-ozet" aria-label="Diğer özellikler">
                    <div class="ozellik-ozet-madde"><strong>MP4 · MP3 · WAV</strong><span>Format seçimi</span></div>
                    <div class="ozellik-ozet-madde"><strong>360p — 1080p</strong><span>Kaliteyi siz belirleyin</span></div>
                    <div class="ozellik-ozet-madde"><strong>Çoklu platform</strong><span>YouTube, Instagram, TikTok ve X</span></div>
                    <div class="ozellik-ozet-madde"><strong>Kayıtsız kullanım</strong><span>Hızlı ve sade başlangıç</span></div>
                </div>
            </section>
        </main>
        <footer>
            <div class="footer-marka"><span>Video İndirici</span></div>
            <p>© 2026 Ömer Denizhan · Lisanssızdır</p>
        </footer>
        <script>
            const seciliFormat = { format: null, kalite: null, tur: null };
            const MAKS_TOPLU_VIDEO = 20;
            let analizVeri = null;
            let aramaSecilen = false;
            let oynatmaModu = false;
            let oynatmaVeri = null;
            let duzenlemeAktif = false;
            let duzenlemeOnizlemeId = null;
            let duzenlemeUrl = '';
            let duzenlemeSure = 0;
            let duzenlemeBaslangic = 0;
            let duzenlemeBitis = 0;
            let kareGuncellemeZamani = null;
            let kareGuncellemeSayaci = 0;
            function indirmeIlerlemesiGoster(metin, durum = 'aktif') {
                const alan = document.getElementById('indirmeIlerleme');
                const yazi = document.getElementById('indirmeIlerlemeMetni');
                const yuzde = document.getElementById('indirmeIlerlemeYuzde');
                const cubuk = alan?.querySelector('[role="progressbar"]');
                if (!alan) return;
                alan.hidden = false;
                alan.classList.remove('tamamlandi', 'hata');
                if (durum === 'tamamlandi') {
                    alan.classList.add('tamamlandi');
                    yuzde.textContent = 'Hazır';
                    cubuk?.setAttribute('aria-valuenow', '100');
                    cubuk?.setAttribute('aria-valuetext', 'İndirme tamamlandı');
                } else if (durum === 'hata') {
                    alan.classList.add('hata');
                    yuzde.textContent = 'Başarısız';
                    cubuk?.setAttribute('aria-valuetext', 'İndirme başarısız');
                } else {
                    yuzde.textContent = 'Sürüyor';
                    cubuk?.removeAttribute('aria-valuenow');
                    cubuk?.setAttribute('aria-valuetext', 'İndirme sürüyor');
                }
                if (yazi) yazi.textContent = metin;
            }
            function indirmeIlerlemesiSifirla() {
                const alan = document.getElementById('indirmeIlerleme');
                if (!alan) return;
                alan.hidden = true;
                alan.classList.remove('tamamlandi', 'hata');
            }
            function mesajGoster(tip, metin) {
                const k = document.getElementById('mesajKutusu');
                k.className = 'mesaj-kutusu aktif ' + tip;
                k.textContent = metin;
            }
            function mesajGizle() {
                document.getElementById('mesajKutusu').className = 'mesaj-kutusu';
            }
            function sekmeDegistir(mod) {
                const baglanti = mod === 'baglanti';
                document.getElementById('baglantiSekmesi').classList.toggle('aktif', baglanti);
                document.getElementById('aramaSekmesi').classList.toggle('aktif', !baglanti);
                document.getElementById('baglantiSekmesi').setAttribute('aria-selected', baglanti ? 'true' : 'false');
                document.getElementById('aramaSekmesi').setAttribute('aria-selected', baglanti ? 'false' : 'true');
                document.getElementById('baglantiPanel').hidden = !baglanti;
                document.getElementById('aramaPanel').classList.toggle('aktif', !baglanti);
                if (!aramaSecilen) document.getElementById('sonucAlani').classList.remove('aktif');
                mesajGizle();
            }
            function sureMetni(saniye) {
                const sn = Number(saniye || 0);
                if (!sn) return '';
                return Math.floor(sn / 60) + ':' + String(sn % 60).padStart(2, '0');
            }
            function tarihMetni(tarih) {
                if (!/^\d{8}$/.test(tarih || '')) return '';
                return tarih.slice(0, 4) + '-' + tarih.slice(4, 6) + '-' + tarih.slice(6, 8);
            }
            function aramaSonuclariniGoster(sonuclar) {
                const alan = document.getElementById('aramaSonuclari');
                if (!sonuclar.length) {
                    alan.innerHTML = '<div class="arama-bos">Bu arama için video bulunamadı.</div>';
                    return;
                }
                alan.innerHTML = sonuclar.map((sonuc, index) => `
                <div class="arama-sonucu">
                <img src="${escHtml(sonuc.kucukResim)}" alt="" loading="lazy">
                <div class="arama-sonucu-bilgi">
                    <div class="arama-sonucu-baslik">${escHtml(sonuc.baslik)}</div>
                    <div class="arama-sonucu-meta">
                    ${sonuc.kanal ? `<span>${escHtml(sonuc.kanal)}</span>` : ''}
                    ${sureMetni(sonuc.sure) ? `<span>${sureMetni(sonuc.sure)}</span>` : ''}
                    ${tarihMetni(sonuc.yayinTarihi) ? `<span>${tarihMetni(sonuc.yayinTarihi)}</span>` : ''}
                    </div>
                </div>
                <button class="arama-sonucu-sec" type="button" data-arama-index="${index}">Seç</button>
                </div>`).join('');
                alan.querySelectorAll('[data-arama-index]').forEach(btn => {
                    btn.addEventListener('click', () => youtubeSonucuSec(sonuclar[Number(btn.dataset.aramaIndex)]));
                });
            }
            async function aramaBaslat() {
                const sorgu = document.getElementById('aramaGiris').value.trim();
                if (!sorgu) return mesajGoster('hata', 'Lütfen bir arama yazın.');
                const btn = document.getElementById('aramaBtn');
                btn.disabled = true;
                btn.innerHTML = '<span class="yukleniyor"></span>';
                mesajGizle();
                document.getElementById('aramaSonuclari').innerHTML = '<div class="arama-bos">YouTube aranıyor...</div>';
                try {
                    const yanit = await fetch('/indir/ara', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ sorgu })
                    });
                    const veri = await yanit.json();
                    if (!veri.basari) {
                        document.getElementById('aramaSonuclari').innerHTML = '';
                        mesajGoster('hata', veri.mesaj || 'Arama başarısız.');
                    } else {
                        aramaSonuclariniGoster(veri.sonuclar || []);
                    }
                } catch {
                    document.getElementById('aramaSonuclari').innerHTML = '';
                    mesajGoster('hata', 'Sunucu ile bağlantı kurulamadı.');
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Ara';
                }
            }
            function youtubeSonucuSec(sonuc) {
                if (!sonuc || !sonuc.url) return;
                aramaSecilen = true;
                document.getElementById('urlGiris').value = sonuc.url;
                document.getElementById('aramaGeri').hidden = false;
                sekmeDegistir('baglanti');
                analizBaslat();
            }
            function aramaSonuclarinaDon() {
                aramaSecilen = false;
                document.getElementById('sonucAlani').classList.remove('aktif');
                sekmeDegistir('arama');
            }
            function oynatmaListesiGoster(veri) {
                const panel = document.getElementById('oynatmaPanel');
                const alan = document.getElementById('oynatmaListesi');
                const maks = Number(veri.maksTopluVideo) || MAKS_TOPLU_VIDEO;
                panel.hidden = false;
                alan.innerHTML = (veri.oynatmaListesi || []).map((video, index) => `
                <label class="oynatma-satir">
                <input type="checkbox" data-oynatma-index="${index}"${index < maks ? ' checked' : ''}>
                <img src="${escHtml(video.kucukResim)}" alt="" loading="lazy">
                <span class="oynatma-satir-bilgi">
                    <span class="oynatma-satir-baslik">${escHtml(video.baslik)}</span>
                    <span class="oynatma-satir-meta">${video.kanal ? escHtml(video.kanal) : ''}${sureMetni(video.sure) ? ` · ${sureMetni(video.sure)}` : ''}</span>
                </span>
                </label>`).join('');
                alan.querySelectorAll('[data-oynatma-index]').forEach(input => {
                    input.addEventListener('change', event => oynatmaSecimGuncelle(event));
                });
                oynatmaSecimGuncelle();
            }
            function oynatmaSecimGuncelle(degisim) {
                const kutular = [...document.querySelectorAll('#oynatmaListesi input[data-oynatma-index]')];
                const maks = Number(oynatmaVeri?.maksTopluVideo) || MAKS_TOPLU_VIDEO;
                const seciliKutular = kutular.filter(kutu => kutu.checked);
                if (seciliKutular.length > maks && degisim?.target?.checked) {
                    degisim.target.checked = false;
                    mesajGoster('bilgi', `En fazla ${maks} video seçebilirsiniz.`);
                }
                const secili = kutular.filter(kutu => kutu.checked).length;
                const toplam = document.querySelectorAll('#oynatmaListesi input[data-oynatma-index]').length;
                document.getElementById('oynatmaSayac').textContent = `${secili} / ${toplam} video seçildi · En fazla ${maks}`;
                document.getElementById('oynatmaTumunuSec').textContent = secili
                    ? (secili === toplam ? 'Tümünü kaldır' : 'Seçimi kaldır')
                    : `İlk ${Math.min(maks, toplam)} videoyu seç`;
            }
            function oynatmaTumunuDegistir() {
                const kutular = [...document.querySelectorAll('#oynatmaListesi input[data-oynatma-index]')];
                const herhangiSecili = kutular.some(kutu => kutu.checked);
                const maks = Number(oynatmaVeri?.maksTopluVideo) || MAKS_TOPLU_VIDEO;
                kutular.forEach((kutu, index) => { kutu.checked = !herhangiSecili && index < maks; });
                oynatmaSecimGuncelle();
            }
            function seciliOynatmaVideolari() {
                if (!oynatmaVeri) return [];
                return [...document.querySelectorAll('#oynatmaListesi input[data-oynatma-index]:checked')]
                    .map(input => oynatmaVeri.oynatmaListesi[Number(input.dataset.oynatmaIndex)])
                    .filter(Boolean);
            }
            async function oynatmaFormatlariniAl(url) {
                const yanit = await fetch('/indir/analiz', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url })
                });
                const veri = await yanit.json();
                if (!veri.basari) throw new Error(veri.mesaj || 'Formatlar alinamadi');
                analizVeri = veri.veri;
                if (!Array.isArray(veri.veri.formatlar) || !veri.veri.formatlar.length) throw new Error('Formatlar alinamadi');
                goruntuleFormatlar(veri.veri.formatlar);
            }
            function varsayilanFormatlariGoster() {
                goruntuleFormatlar([
                    { tur: 'video', kalite: '360p' },
                    { tur: 'video', kalite: '480p' },
                    { tur: 'video', kalite: '720p' },
                    { tur: 'video', kalite: '1080p' },
                    { tur: 'ses', format: 'mp3' },
                    { tur: 'ses', format: 'wav' }
                ]);
            }
            function zamanMetni(saniye) {
                const toplam = Math.max(0, Math.round(Number(saniye) || 0));
                const saat = Math.floor(toplam / 3600);
                const dakika = Math.floor((toplam % 3600) / 60);
                const saniyeKismi = toplam % 60;
                return `${saat ? String(saat).padStart(2, '0') + ':' : ''}${String(dakika).padStart(2, '0')}:${String(saniyeKismi).padStart(2, '0')}`;
            }
            function zamanSayisi(deger) {
                const parcalar = String(deger || '').trim().split(':').map(Number);
                if (!parcalar.length || parcalar.some(parca => !Number.isFinite(parca))) return null;
                if (parcalar.length === 1) return parcalar[0];
                if (parcalar.length === 2) return parcalar[0] * 60 + parcalar[1];
                if (parcalar.length === 3) return parcalar[0] * 3600 + parcalar[1] * 60 + parcalar[2];
                return null;
            }
            function duzenlemeAraliginiGuncelle() {
                const baslangicKaydiraci = document.getElementById('baslangicKaydiraci');
                const bitisKaydiraci = document.getElementById('bitisKaydiraci');
                if (!baslangicKaydiraci || !bitisKaydiraci) return;
                duzenlemeBaslangic = Math.max(0, Math.min(Number(baslangicKaydiraci.value), duzenlemeSure));
                duzenlemeBitis = Math.max(0, Math.min(Number(bitisKaydiraci.value), duzenlemeSure));
                if (duzenlemeBaslangic >= duzenlemeBitis) {
                    if (document.activeElement === baslangicKaydiraci) {
                        duzenlemeBaslangic = Math.max(0, duzenlemeBitis - 0.1);
                        baslangicKaydiraci.value = String(duzenlemeBaslangic);
                    } else {
                        duzenlemeBitis = Math.min(duzenlemeSure, duzenlemeBaslangic + 0.1);
                        bitisKaydiraci.value = String(duzenlemeBitis);
                    }
                }
                document.getElementById('baslangicZamani').value = zamanMetni(duzenlemeBaslangic);
                document.getElementById('bitisZamani').value = zamanMetni(duzenlemeBitis);
                document.getElementById('baslangicEtiketi').textContent = zamanMetni(duzenlemeBaslangic);
                document.getElementById('bitisEtiketi').textContent = zamanMetni(duzenlemeBitis);
                document.getElementById('seciliSureEtiketi').textContent = `Seçim: ${zamanMetni(duzenlemeBitis - duzenlemeBaslangic)}`;
                const seciliTimeline = document.getElementById('timelineSecili');
                const sol = duzenlemeSure ? (duzenlemeBaslangic / duzenlemeSure) * 100 : 0;
                const genislik = duzenlemeSure ? ((duzenlemeBitis - duzenlemeBaslangic) / duzenlemeSure) * 100 : 0;
                seciliTimeline.style.left = `${sol}%`;
                seciliTimeline.style.width = `${Math.max(0, genislik)}%`;
                document.getElementById('baslangicKareZamani').textContent = zamanMetni(duzenlemeBaslangic);
                document.getElementById('bitisKareZamani').textContent = zamanMetni(duzenlemeBitis);
                kareleriGuncellemePlanla();
                document.getElementById('indirLink').innerHTML = '';
            }
            function kareleriGuncellemePlanla() {
                clearTimeout(kareGuncellemeZamani);
                kareGuncellemeZamani = setTimeout(() => duzenlemeKareleriniGuncelle(), 140);
            }
            function videoKonumunaGit(video, saniye) {
                return new Promise(resolve => {
                    const hedef = Math.max(0, Math.min(saniye, video.duration || saniye));
                    let tamamlandi = false;
                    let kareBekleniyor = false;
                    let zamanAsimi;
                    const kareyiBekle = () => {
                        if (kareBekleniyor) return;
                        kareBekleniyor = true;
                        let kareHazir = false;
                        const tamamla = () => {
                            if (kareHazir) return;
                            kareHazir = true;
                            resolve();
                        };
                        if (typeof video.requestVideoFrameCallback === 'function') video.requestVideoFrameCallback(tamamla);
                        requestAnimationFrame(() => requestAnimationFrame(tamamla));
                        setTimeout(tamamla, 120);
                    };
                    const bitir = () => {
                        if (tamamlandi) return;
                        tamamlandi = true;
                        clearTimeout(zamanAsimi);
                        video.removeEventListener('seeked', bitir);
                        kareyiBekle();
                    };
                    video.addEventListener('seeked', bitir, { once: true });
                    if (Math.abs(video.currentTime - hedef) < 0.05) {
                        bitir();
                    } else {
                        video.currentTime = hedef;
                        zamanAsimi = setTimeout(bitir, 2000);
                    }
                });
            }
            async function duzenlemeKareleriniGuncelle() {
                const video = document.getElementById('kareVideo');
                if (!duzenlemeAktif || !video) return;
                if (video.readyState < 2 || !video.videoWidth) {
                    clearTimeout(kareGuncellemeZamani);
                    kareGuncellemeZamani = setTimeout(() => duzenlemeKareleriniGuncelle(), 250);
                    return;
                }
                const sayac = ++kareGuncellemeSayaci;
                video.pause();
                const canvas = document.createElement('canvas');
                const oran = Math.min(1, 640 / video.videoWidth);
                canvas.width = Math.max(1, Math.round(video.videoWidth * oran));
                canvas.height = Math.max(1, Math.round(video.videoHeight * oran));
                const context = canvas.getContext('2d');
                try {
                    await videoKonumunaGit(video, duzenlemeBaslangic);
                    if (sayac !== kareGuncellemeSayaci) return;
                    context.drawImage(video, 0, 0, canvas.width, canvas.height);
                    document.getElementById('baslangicKaresi').src = canvas.toDataURL('image/jpeg', 0.82);
                    await videoKonumunaGit(video, duzenlemeBitis);
                    if (sayac !== kareGuncellemeSayaci) return;
                    context.drawImage(video, 0, 0, canvas.width, canvas.height);
                    document.getElementById('bitisKaresi').src = canvas.toDataURL('image/jpeg', 0.82);
                } catch { }
            }
            function duzenlemeZamanAlaniniUygula(inputId, kaydiracId) {
                const input = document.getElementById(inputId);
                const saniye = zamanSayisi(input.value);
                if (saniye === null) {
                    input.value = zamanMetni(inputId === 'baslangicZamani' ? duzenlemeBaslangic : duzenlemeBitis);
                    return;
                }
                const kaydirac = document.getElementById(kaydiracId);
                kaydirac.value = String(Math.max(0, Math.min(saniye, duzenlemeSure)));
                duzenlemeAraliginiGuncelle();
            }
            function duzenlemeOnizlemesiniKapat() {
                const video = document.getElementById('duzenlemeVideo');
                const kareVideo = document.getElementById('kareVideo');
                clearTimeout(kareGuncellemeZamani);
