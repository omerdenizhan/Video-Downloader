                    mesajGoster(basarisiz ? 'bilgi' : 'basari', `${basarili.length} video hazır${basarisiz ? `, ${basarisiz} video indirilemedi` : ''}.`);
                    document.getElementById('indirLink').innerHTML = `<div class="toplu-sonuclar">${basarili.map(sonuc => {
                        const format = ['mp4', 'mp3', 'wav'].includes(sonuc.format) ? sonuc.format : 'mp4';
                        const ad = String(sonuc.dosyaAdi || 'dosya').replace(/\.(mp4|mp3|wav)$/i, '');
                        return `<a class="toplu-indirme-link" href="/indir/dosya/${encodeURIComponent(sonuc.indirmeId)}/${format}?ad=${encodeURIComponent(ad)}" data-dosya-adi="${escHtml(ad)}.${format}" download>
                    <span>${escHtml(ad)}.${format}</span><span>İndir ↓</span>
                    </a>`;
                    }).join('')}</div>`;
                    document.querySelectorAll('.toplu-indirme-link').forEach(link => {
                        link.addEventListener('click', event => topluDosyaIndir(event, link));
                    });
                } catch {
                    indirmeIlerlemesiGoster('İndirme sırasında bağlantı hatası oluştu.', 'hata');
                    mesajGoster('hata', 'Sunucu ile bağlantı kurulamadı.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = `<span>↓</span> ${seciliFormat.format.toUpperCase()}${seciliFormat.kalite ? ' · ' + seciliFormat.kalite : ''} Seçilenleri İndir`;
                }
            }
            async function topluDosyaIndir(event, link) {
                event.preventDefault();
                if (link.dataset.indiriliyor === 'true') return;
                link.dataset.indiriliyor = 'true';
                link.classList.add('yukleniyor');
                try {
                    const yanit = await fetch(link.href, { headers: { Accept: 'audio/mpeg, audio/wav, video/mp4' } });
                    const tip = (yanit.headers.get('content-type') || '').toLowerCase();
                    if (!yanit.ok || tip.includes('text/html') || tip.includes('application/json')) {
                        throw new Error('Dosya sunucuda bulunamadi');
                    }
                    const blob = await yanit.blob();
                    const geciciUrl = URL.createObjectURL(blob);
                    const indirme = document.createElement('a');
                    indirme.href = geciciUrl;
                    indirme.download = link.dataset.dosyaAdi || 'dosya.mp3';
                    document.body.appendChild(indirme);
                    indirme.click();
                    indirme.remove();
                    setTimeout(() => URL.revokeObjectURL(geciciUrl), 1000);
                } catch {
                    mesajGoster('hata', 'Bu dosya hazir degil veya suresi dolmus. Lutfen toplu indirmeyi tekrar baslatin.');
                } finally {
                    link.dataset.indiriliyor = 'false';
                    link.classList.remove('yukleniyor');
                }
            }
