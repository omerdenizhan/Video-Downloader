            function goruntuleFormatlar(formatlar) {
                const video = formatlar.filter(f => f.tur === 'video');
                const ses = formatlar.filter(f => f.tur === 'ses');
                const videoAlani = document.getElementById('videoFormatlar');
                const sesAlani = document.getElementById('sesFormatlar');
                videoAlani.innerHTML = video.map(f =>
                    `<button class="format-kart" type="button" data-format="mp4" data-kalite="${f.kalite}" data-tur="video">
                <div class="format-ad">MP4</div>
                <div class="format-tur">${f.kalite}</div>
                </button>`).join('') || '<p class="not-orta">Video formatı bulunamadı.</p>';
                sesAlani.innerHTML = ses.map(f =>
