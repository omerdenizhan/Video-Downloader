<!DOCTYPE html>

<html lang="tr" data-tema="aydinlik">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
        <meta name="theme-color" content="#eef0f8">
        <link rel="icon" type="image/png" href="/favicon.png">
        <script src="/tema.js"></script>
        <title>Admin Girişi · Video İndirici</title>
        <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/tema.css">
    </head>
    <body class="sayfa-admin-giris">
        <div class="tema-sabit">
            <button class="tema-btn" id="temaDugmesi" type="button" data-tema-btn aria-label="Karanlık moda geç"></button>
            </div>
        <div class="kap">
            <div class="logo">
                <img class="logo-simge" src="/favicon.png" alt="">
                <div class="logo-yazi"><span>Video İndirici</span><br>Admin Paneli</div>
            </div>
            <div class="kart">
                <h2>Yönetici Girişi</h2>
                <% if (hata) { %>
                <div class="hata-mesaj">
                    <%= hata %>
                </div>
                <% } %>
                <form method="POST" action="/admin/giris">
                    <div class="alan">
                        <label>Kullanıcı Adı</label>
                        <input type="text" name="kullanici" required autocomplete="username">
                    </div>
                    <div class="alan">
                        <label>Şifre</label>
                        <input type="password" name="sifre" required autocomplete="current-password">
                    </div>
                    <button type="submit" class="giris-btn">Giriş Yap</button>
                </form>
            </div>
        </div>
    </body>
</html>
